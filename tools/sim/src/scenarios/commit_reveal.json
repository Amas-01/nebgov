{
  "name": "commit_reveal",
  "description": "Two-phase commit-reveal vote: three voters commit during the commit phase, one reveals early and is rejected, one commits after the commit deadline, one reveals with a wrong salt, and one never reveals (so their commitment never counts). Checks the tally and the Active -> Succeeded -> Queued -> Executed transitions",
  "seed": 4,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000,
    "use_commit_reveal": true,
    "commit_phase_fraction": 5000
  },
  "actors": [
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "bob", "initial_balance": 500, "delegate_to": null, "role": "TokenHolder" },
    { "name": "carol", "initial_balance": 300, "delegate_to": null, "role": "TokenHolder" },
    { "name": "dave", "initial_balance": 200, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "commit-reveal proposal" },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Pending" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Active" },

    { "type": "CommitVote", "actor": "bob", "proposal_id": 1, "support": "For", "weight_seed": 11, "salt": 1 },
    { "type": "CommitVote", "actor": "carol", "proposal_id": 1, "support": "Against", "weight_seed": 22, "salt": 2 },
    { "type": "CommitVote", "actor": "dave", "proposal_id": 1, "support": "For", "weight_seed": 33, "salt": 3 },
    { "type": "RevealVote", "actor": "bob", "proposal_id": 1, "support": "For", "weight_seed": 11, "salt": 1 },

    { "type": "AdvanceLedger", "ledgers": 5 },
    { "type": "CommitVote", "actor": "alice", "proposal_id": 1, "support": "For", "weight_seed": 44, "salt": 4 },
    { "type": "RevealVote", "actor": "bob", "proposal_id": 1, "support": "For", "weight_seed": 11, "salt": 9 },
    { "type": "RevealVote", "actor": "bob", "proposal_id": 1, "support": "For", "weight_seed": 11, "salt": 1 },
    { "type": "RevealVote", "actor": "carol", "proposal_id": 1, "support": "Against", "weight_seed": 22, "salt": 2 },
    { "type": "ExpectTally", "proposal_id": 1, "votes_for": 500, "votes_against": 300, "votes_abstain": 0 },

    { "type": "AdvanceLedger", "ledgers": 5 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Succeeded" },
    { "type": "Queue", "actor": "alice", "proposal_id": 1 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Queued" },
    { "type": "AdvanceLedger", "ledgers": 1 },
    { "type": "Execute", "actor": "alice", "proposal_id": 1 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Executed" },

    { "type": "ExpectError", "step_index": 7, "expected_error": "Error(Contract, #46)" },
    { "type": "ExpectError", "step_index": 9, "expected_error": "Error(Contract, #45)" },
    { "type": "ExpectError", "step_index": 10, "expected_error": "Error(Contract, #48)" }
  ]
}
