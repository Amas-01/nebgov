{
  "name": "guardian_council",
  "description": "A 2-of-3 guardian council is the governor's guardian: it cancels a proposal once threshold approvals are met; a member rotation removes an approver so a pending action drops below threshold until a new member approves; and an action that is not executed within its TTL expires",
  "seed": 5,
  "governor_settings": {
    "voting_delay": 1,
    "voting_period": 10,
    "quorum_numerator": 10,
    "proposal_threshold": 100,
    "vote_type": "Extended",
    "proposal_grace_period": 1000,
    "max_calldata_size": 10000,
    "proposal_cooldown": 0,
    "max_proposals_per_period": 5,
    "proposal_period_duration": 10000
  },
  "actors": [
    { "name": "alice", "initial_balance": 1000, "delegate_to": null, "role": "Proposer" },
    { "name": "m1", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "m2", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "m3", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" },
    { "name": "m4", "initial_balance": 0, "delegate_to": null, "role": "TokenHolder" }
  ],
  "steps": [
    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "proposal the council cancels" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Active" },
    { "type": "DeployGuardianCouncil", "members": ["m1", "m2", "m3"], "threshold": 2, "action_ttl_ledgers": 20 },

    { "type": "CouncilPropose", "actor": "m3", "action": { "kind": "CancelActive", "proposal_id": 1 } },
    { "type": "CouncilApprove", "actor": "m2", "action_id": 0 },
    { "type": "CouncilExecute", "action_id": 0 },
    { "type": "ExpectState", "proposal_id": 1, "expected_state": "Cancelled" },

    { "type": "Propose", "actor": "alice", "targets": ["target"], "fn_names": ["noop"], "description": "proposal the council cancels after a rotation" },
    { "type": "AdvanceLedger", "ledgers": 2 },
    { "type": "ExpectState", "proposal_id": 2, "expected_state": "Active" },

    { "type": "CouncilPropose", "actor": "m3", "action": { "kind": "CancelActive", "proposal_id": 2 } },
    { "type": "CouncilApprove", "actor": "m2", "action_id": 1 },
    { "type": "CouncilPropose", "actor": "m1", "action": { "kind": "RotateMember", "old_member": "m2", "new_member": "m4" } },
    { "type": "CouncilApprove", "actor": "m3", "action_id": 2 },
    { "type": "CouncilExecute", "action_id": 2 },
    { "type": "CouncilExecute", "action_id": 1 },
    { "type": "ExpectCouncilAction", "action_id": 1, "approvals": 2, "executed": false },
    { "type": "CouncilApprove", "actor": "m4", "action_id": 1 },
    { "type": "CouncilExecute", "action_id": 1 },
    { "type": "ExpectState", "proposal_id": 2, "expected_state": "Cancelled" },

    { "type": "CouncilPropose", "actor": "m1", "action": { "kind": "CancelActive", "proposal_id": 1 } },
    { "type": "CouncilApprove", "actor": "m3", "action_id": 3 },
    { "type": "CouncilApprove", "actor": "m2", "action_id": 3 },
    { "type": "AdvanceLedger", "ledgers": 21 },
    { "type": "CouncilExecute", "action_id": 3 },

    { "type": "ExpectError", "step_index": 16, "expected_error": "Error(Contract, #6)" },
    { "type": "ExpectError", "step_index": 23, "expected_error": "Error(Contract, #3)" },
    { "type": "ExpectError", "step_index": 25, "expected_error": "Error(Contract, #7)" },
    { "type": "ExpectCouncilAction", "action_id": 0, "approvals": 2, "executed": true }
  ]
}
